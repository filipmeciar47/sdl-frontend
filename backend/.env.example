ANTHROPIC_API_KEY=sk-ant-...

# CORS allowlist (ciarkou oddelene originy) — POVINNE.
# Bez tejto premennej endpoint vracia 503 a appka nefunguje. Nastav ju vo Vercel
# projekte `backend` (Settings -> Environment Variables) SKOR, nez deploynes kod.
# Uvadzaj plny origin vratane https:// a bez lomitka na konci.
# Preview deploye frontendu pridaj sem tiez — zamerne na ne nie je regex, lebo
# vzor `frontend-*.vercel.app` by pustil hocijaky cudzi Vercel projekt.
ALLOWED_ORIGINS=https://moj-frontend.vercel.app
# lokalny dev: ALLOWED_ORIGINS=http://localhost:5173

# Best-effort rate-limit na IP za minutu (default 30). Zvys, ak legitimni
# uzivatelia dostavaju 429 — napr. viac ludi za jednou firemnou IP.
# Toto je len tlmic; skutocny strop nakladov je Spend limit v Anthropic konzole
# a Vercel Firewall -> Rate limiting.
# RATE_LIMIT_PER_MIN=30
